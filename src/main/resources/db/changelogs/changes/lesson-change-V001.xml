<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="014-add-course-id-fk-to-lesson" author="sydorenko">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="lesson"/>
            <tableExists tableName="course"/>
            <not>
                <columnExists tableName="lesson" columnName="course_id"/>
            </not>
        </preConditions>

        <addColumn tableName="lesson">
            <column name="course_id" type="BIGINT"/>
        </addColumn>

        <addForeignKeyConstraint baseTableName="lesson"
                                 baseColumnNames="course_id"
                                 constraintName="fk_lesson_course"
                                 referencedTableName="course"
                                 referencedColumnNames="id"
                                 onDelete="NO ACTION"/>
        
        <createIndex tableName="lesson" indexName="idx_lesson_course_id">
            <column name="course_id"/>
        </createIndex>

        <sql>
            INSERT INTO dbo.tables (db_, name, type, author, version, service, description, column_count, created_at, last_update_at )
            VALUES (
            'liquibase_lab',
            'lesson',
            'SYSTEM',
            'sydorenko',
            (SELECT COALESCE(MAX(version), 0) + 1 FROM dbo.tables WHERE name = 'lesson' AND db_ = 'liquibase_lab'),
            'content_service',
            'Add course_id foreign key to lesson table.',
            (SELECT COUNT(*) FROM sys.columns WHERE object_id = OBJECT_ID('lesson')),
            SYSUTCDATETIME(),
            SYSUTCDATETIME());
        </sql>

        <rollback>
            <dropIndex tableName="lesson" indexName="idx_lesson_course_id"/>
            <dropForeignKeyConstraint baseTableName="lesson" constraintName="fk_lesson_course"/>
            <dropColumn tableName="lesson" columnName="course_id"/>
            <sql>
                DELETE FROM dbo.tables
                WHERE name = 'lesson'
                AND db_ = 'liquibase_lab'
                AND version = (SELECT MAX(version) FROM dbo.tables WHERE name = 'lesson' AND db_ = 'liquibase_lab');
            </sql>
        </rollback>
    </changeSet>
</databaseChangeLog>
