<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="014-add-course-id-fk-to-lesson" author="sydorenko">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="lesson"/>
            <tableExists tableName="course"/>
            <not>
                <columnExists tableName="lesson" columnName="course_id"/>
            </not>
        </preConditions>

        <addColumn tableName="lesson">
            <column name="course_id" type="BIGINT"/>
        </addColumn>

        <addForeignKeyConstraint baseTableName="lesson"
                                 baseColumnNames="course_id"
                                 constraintName="fk_lesson_course"
                                 referencedTableName="course"
                                 referencedColumnNames="id"
                                 onDelete="NO ACTION"/>
        
        <createIndex tableName="lesson" indexName="idx_lesson_course_id">
            <column name="course_id"/>
        </createIndex>

        <rollback>
            <dropForeignKeyConstraint baseTableName="lesson" constraintName="fk_lesson_course"/>
            <dropColumn tableName="lesson" columnName="course_id"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
